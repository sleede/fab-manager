# For development & test environments, copy this file to database.yml
# For staging & production environments, use docker/database.yml

development:
  adapter: postgresql
  host: <%= ENV.fetch('POSTGRES_HOST', 'fabmanager-postgres').to_json %>
  encoding: unicode
  database: <%= ENV.fetch("POSTGRES_DB", "fabmanager_development").to_json %>
  pool: 25
  username: <%= ENV.fetch('POSTGRES_USERNAME', 'postgres').to_json %>
  password: <%= (ENV["POSTGRES_PASSWORD_FILE"] ? File.read(ENV.fetch("POSTGRES_PASSWORD_FILE")).strip : (ENV["POSTGRES_PASSWORD"].to_s.empty? ? "postgres" : ENV["POSTGRES_PASSWORD"])).to_json %>

# Warning: The database defined as "test" will be erased and
# re-generated from your development database when you run "rake".
# Do not set this db to the same as development or production.
test:
  adapter: postgresql
  host: <%= ENV.fetch('POSTGRES_HOST', 'fabmanager-postgres').to_json %>
  encoding: unicode
  database: <%= ENV.fetch("POSTGRES_TEST_DB", "fabmanager_test").to_json %>
  pool: 25
  username: <%= ENV.fetch('POSTGRES_USERNAME', 'postgres').to_json %>
  password: <%= (ENV["POSTGRES_PASSWORD_FILE"] ? File.read(ENV.fetch("POSTGRES_PASSWORD_FILE")).strip : (ENV["POSTGRES_PASSWORD"].to_s.empty? ? "postgres" : ENV["POSTGRES_PASSWORD"])).to_json %>
